# Copy to .env and fill in. Variables prefixed PUBLIC_ are embedded in the site.

# Final domain (canonical URLs, sitemap, hreflang, OG images)
SITE_URL=https://www.texturedublin.ie

# Contact — WhatsApp number in international format, digits only (353 + number without leading 0)
PUBLIC_WHATSAPP_NUMBER=353870000000
PUBLIC_PHONE_DISPLAY=087 000 0000
PUBLIC_PHONE_E164=+353870000000
PUBLIC_EMAIL=hello@texturedublin.ie

# Analytics & advertising (leave empty to disable)
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_WA_LABEL=
PUBLIC_META_PIXEL_ID=
# basic = no tags before consent (default) | advanced = Google tags load in denied state
PUBLIC_CONSENT_MODE=basic

# Site verification
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=

# Social profiles (full URLs)
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_TIKTOK_URL=
PUBLIC_LINKEDIN_URL=
PUBLIC_PINTEREST_URL=
PUBLIC_GOOGLE_BUSINESS_URL=
PUBLIC_GOOGLE_REVIEW_URL=

# Company details shown in the footer and legal pages
PUBLIC_VAT_NUMBER=
PUBLIC_CRO_NUMBER=

# Hosting under an existing domain (use / for the final standalone domain)
BASE_PATH=/
# true for the shareable preview; false for the final verified business site
PUBLIC_SITE_PREVIEW=false
