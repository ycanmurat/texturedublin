---
import type { Locale } from '../data/types.ts';
import { areas } from '../data/areas.ts';
import { serviceById } from '../data/services.ts';
import { zones } from '../data/zones.ts';
import { site } from '../config/site.ts';
import { ui } from '../i18n/ui.ts';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  start?: 'wardrobes' | 'kitchens' | 'builtins' | 'assembly' | 'signs';
  area?: string;
}
const { locale, start = 'wardrobes', area } = Astro.props;
const t = ui[locale].estimator;

const pick = (sid: string, ids: string[]) =>
  Object.fromEntries(ids.map((id) => {
    const it = serviceById[sid].items.find((i) => i.id === id)!;
    return [id, [it.from, it.to ?? it.from]];
  }));

const data = {
  wa: site.whatsapp,
  zones: Object.fromEntries(Object.values(zones).map((z) => [z.id, { m: z.multiplier, min: z.minVisit }])),
  areas: areas.map((a) => [a.id, a.name[locale], a.zone]),
  p: {
    wardrobes: pick('fitted-wardrobes', ['hinged', 'sliding']),
    kitchens: pick('bespoke-kitchens', ['compact', 'family', 'island']),
    builtins: pick('built-in-units', ['alcovePair', 'media', 'bookcase', 'office', 'understairs']),
    assembly: pick('furniture-assembly', ['bed', 'wardrobe2', 'wardrobeLarge', 'drawers', 'desk', 'dining']),
    signs: { ...pick('shop-signs', ['panel', 'painted', 'letters', 'install']), ...pick('illuminated-led-signs', ['lightbox', 'halo', 'electrical']) },
  },
  t: { ...t, incVat: ui[locale].price.incVat, exVat: ui[locale].price.exVat, area: t.area, min: ui[locale].price.minVisit },
};
const tabs = ['wardrobes', 'kitchens', 'builtins', 'assembly', 'signs'] as const;
---

<div class="estimator" data-estimator data-start={start}>
  <div class="est-form">
    <div class="est-tabs" role="tablist" aria-label={t.service}>
      {tabs.map((k) => <button type="button" role="tab" id={`est-tab-${k}`} aria-controls={`est-${k}`} aria-selected={k === start ? 'true' : 'false'} data-tab={k}>{t.services[k]}</button>)}
    </div>

    <div class="field" style="margin-top:22px">
      <label for="est-area">{t.area}</label>
      <select class="select" id="est-area" data-area>
        <option value="">{t.areaAny}</option>
        {areas.map((a) => <option value={a.id} selected={a.id === area}>{a.name[locale]} · {a.postal}</option>)}
      </select>
    </div>

    <div class="est-panel" role="tabpanel" id="est-wardrobes" aria-labelledby="est-tab-wardrobes" data-panel="wardrobes" style="margin-top:22px">
      <div class="est-row">
        <div class="est-row-head"><label for="w-width">{t.width}</label><output data-out="w-width">2.4 {t.metres}</output></div>
        <input class="range" id="w-width" type="range" min="1" max="6" step="0.1" value="2.4" data-k="width" />
      </div>
      <div class="est-row"><span class="label">{t.doors}</span>
        <div class="segmented"><label><input type="radio" name="w-doors" value="hinged" checked /><span>{t.hinged}</span></label><label><input type="radio" name="w-doors" value="sliding" /><span>{t.sliding}</span></label></div>
      </div>
      <div class="est-row"><span class="label">{t.interior}</span>
        <div class="segmented"><label><input type="radio" name="w-int" value="0" checked /><span>{t.standard}</span></label><label><input type="radio" name="w-int" value="1" /><span>{t.premium}</span></label></div>
      </div>
      <div class="est-row"><span class="label">{t.finish}</span>
        <div class="segmented">{t.finishes.map((f, i) => <label><input type="radio" name="w-fin" value={i} checked={i === 0} /><span>{f}</span></label>)}</div>
      </div>
    </div>

    <div class="est-panel" role="tabpanel" id="est-kitchens" aria-labelledby="est-tab-kitchens" data-panel="kitchens" hidden style="margin-top:22px">
      <div class="est-row"><span class="label">{t.size}</span>
        <div class="segmented">{t.kitchenSizes.map((f, i) => <label><input type="radio" name="k-size" value={i} checked={i === 1} /><span>{f}</span></label>)}</div>
      </div>
      <div class="est-row"><span class="label">{t.worktop}</span>
        <div class="segmented">{t.worktops.map((f, i) => <label><input type="radio" name="k-top" value={i} checked={i === 0} /><span>{f}</span></label>)}</div>
      </div>
    </div>

    <div class="est-panel" role="tabpanel" id="est-builtins" aria-labelledby="est-tab-builtins" data-panel="builtins" hidden style="margin-top:22px">
      <div class="est-row"><span class="label">{t.type}</span>
        <div class="segmented">{t.builtinTypes.map((f, i) => <label><input type="radio" name="b-type" value={i} checked={i === 0} /><span>{f}</span></label>)}</div>
      </div>
      <div class="est-row" data-only="b-width">
        <div class="est-row-head"><label for="b-width">{t.width}</label><output data-out="b-width">3 {t.metres}</output></div>
        <input class="range" id="b-width" type="range" min="1" max="6" step="0.1" value="3" />
      </div>
      <div class="est-row"><span class="label">{t.finish}</span>
        <div class="segmented">{t.finishes.map((f, i) => <label><input type="radio" name="b-fin" value={i} checked={i === 1} /><span>{f}</span></label>)}</div>
      </div>
    </div>

    <div class="est-panel" role="tabpanel" id="est-assembly" aria-labelledby="est-tab-assembly" data-panel="assembly" hidden style="margin-top:22px">
      <div class="assembly-list">
        {Object.entries(t.assemblyItems).map(([k, label]) => (
          <div>
            <span>{label}</span>
            <span class="stepper" data-step={k}>
              <button type="button" aria-label={`− ${label}`} data-d="-1">−</button>
              <output data-qty={k}>{k === 'bed' ? 1 : 0}</output>
              <button type="button" aria-label={`+ ${label}`} data-d="1">+</button>
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="est-panel" role="tabpanel" id="est-signs" aria-labelledby="est-tab-signs" data-panel="signs" hidden style="margin-top:22px">
      <div class="est-row"><span class="label">{t.type}</span>
        <div class="segmented">{t.signTypes.map((f, i) => <label><input type="radio" name="s-type" value={i} checked={i === 0} /><span>{f}</span></label>)}</div>
      </div>
      <div class="est-row">
        <div class="est-row-head"><label for="s-width">{t.width}</label><output data-out="s-width">3 {t.metres}</output></div>
        <input class="range" id="s-width" type="range" min="1" max="8" step="0.5" value="3" />
      </div>
      <div class="est-row"><span class="label">{t.install}</span>
        <div class="segmented"><label><input type="radio" name="s-inst" value="1" checked /><span>{ui[locale].common.yes}</span></label><label><input type="radio" name="s-inst" value="0" /><span>{ui[locale].common.no}</span></label></div>
      </div>
    </div>
  </div>

  <div class="est-result" aria-live="polite">
    <div>
      <p class="eyebrow">{t.result}</p>
      <p class="total num" data-total style="margin-top:14px">—<small data-vat></small></p>
    </div>
    <div class="stack" style="--stack:14px">
      <a class="btn btn--wa" href="#" target="_blank" rel="noopener" data-est-send data-track="whatsapp" data-placement="estimator"><Icon name="whatsapp" />{t.send}</a>
      <p class="small" style="color:#bdb2a3">{t.disclaimer}</p>
    </div>
  </div>
  <script type="application/json" data-est-data set:html={JSON.stringify(data)} />
</div>

<script>
  import '../scripts/estimator.ts';
</script>
