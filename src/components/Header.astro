---
import type { L10n, Locale } from '../data/types.ts';
import { signage, woodworks } from '../data/services.ts';
import { site } from '../config/site.ts';
import { ui } from '../i18n/ui.ts';
import { href, LOCALES, type RouteKey } from '../lib/routes.ts';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  path: string;
  alternates: L10n | null;
  tone?: 'dark' | 'light';
  wa: string;
}
const { locale, path, alternates, tone = 'light', wa } = Astro.props;
const t = ui[locale];
const langHref = (l: Locale) => (alternates ? alternates[l] : href(l, 'home'));

const nav: Array<{ key: RouteKey; label: string }> = [
  { key:'furnitureHub', label: locale === 'en' ? 'Furniture' : 'Troscán' },
  { key:'signageHub', label: locale === 'en' ? 'Signage' : 'Comharthaíocht' },
  { key:'guides', label:t.nav.guides },
  { key:'contact', label:t.nav.contact },
];
const isCurrent = (k: RouteKey) => {
  const h = href(locale, k);
  return path === h || (k !== 'home' && path.startsWith(h));
};
const servicesHref = href(locale, 'services');
const columns = [
  { key: 'furnitureHub' as RouteKey, kicker: t.mega.woodKicker, title: t.nav.woodworks, list: woodworks, cls: 'mega-col--wood' },
  { key: 'signageHub' as RouteKey, kicker: t.mega.signKicker, title: t.nav.signage, list: signage, cls: 'mega-col--sign' },
];
---

<header class="site-header" id="site-header" data-tone={tone}>
  <div class="container">
    <a class="brand" href={href(locale, 'home')} aria-label={`${site.name} — ${t.nav.home}`}>
      <Logo variant="compact" title={site.name} textId="td-wordmark" markId="td-markg" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        <li class="nav-item nav-item--mega" data-mega>
          <a class="nav-link" href={servicesHref} aria-current={path.startsWith(servicesHref) ? 'page' : undefined}>
            {t.nav.services}
            <Icon name="chevron" />
          </a>
          <div class="mega" role="group" aria-label={t.nav.services}>
            {columns.map((c, ci) => (
              <div class={`mega-col ${c.cls}`}>
                <a class="mega-head" href={href(locale, c.key)}>
                  <span class="mega-kicker">0{ci + 1} · {c.kicker}</span>
                  <span class="mega-title">{c.title} <Icon name="arrow" /></span>
                </a>
                <ul class="mega-list">
                  {c.list.map((s) => (
                    <li>
                      <a href={href(locale, 'service', { service: s.id })} aria-current={path === href(locale, 'service', { service: s.id }) ? 'page' : undefined}>
                        <span class="mega-name">{s.name[locale]}</span>
                        <span class="mega-desc">{s.menu?.[locale]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="mega-aside dark">
              <span class="mega-kicker">{t.mega.asideKicker}</span>
              <p class="mega-aside-title">{t.mega.asideTitle}</p>
              <p class="mega-aside-text">{t.mega.asideText}</p>
              <a class="btn btn--wa btn--sm" href={wa} target="_blank" rel="noopener" data-track="whatsapp" data-placement="mega-menu"><Icon name="whatsapp" />{t.wa.cta}</a>
              <a class="mega-phone" href={`tel:${site.phone.e164}`}><Icon name="phone" />{site.phone.display}</a>
              <ul class="mega-links">
                <li><a href={servicesHref}>{t.nav.allServices} <Icon name="arrow" /></a></li>
                <li><a href={href(locale, 'areas')}>{t.mega.areas} <Icon name="arrow" /></a></li>
                <li><a href={href(locale, 'guides')}>{t.mega.guides} <Icon name="arrow" /></a></li>
                <li><a href={href(locale, 'pricing')}>{t.cta.allPrices} <Icon name="arrow" /></a></li>
              </ul>
            </div>
          </div>
        </li>
        {
          nav.map((n) => (
            <li class="nav-item">
              <a class="nav-link" href={href(locale, n.key)} aria-current={isCurrent(n.key) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <nav class="lang-toggle" aria-label={t.nav.language}>
        <Icon name="globe" />
        {LOCALES.map((l) => (
          <a href={langHref(l)} hreflang={ui[l].meta.htmlLang} lang={ui[l].meta.htmlLang} title={ui[l].meta.name} aria-label={ui[l].meta.name} aria-current={l === locale ? 'true' : undefined}>{ui[l].meta.short}</a>
        ))}
      </nav>
      <a class="btn btn--wa btn--sm header-wa" href={wa} target="_blank" rel="noopener" data-track="whatsapp" data-placement="header">
        <Icon name="whatsapp" />
        {t.wa.cta}
      </a>
      <a class="icon-btn icon-btn--wa" href={wa} target="_blank" rel="noopener" data-track="whatsapp" data-placement="header-mobile" aria-label={t.wa.cta}>
        <Icon name="whatsapp" />
      </a>
      <button class="icon-btn burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.nav.menu}>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu dark" id="mobile-menu" aria-hidden="true">
  <nav aria-label="Mobile">
    <ul class="mm-main">
      {
        [{ key: 'services' as RouteKey, label: t.nav.services }, ...nav, {key:'areas' as RouteKey,label:t.nav.areas}, {key:'pricing' as RouteKey,label:t.nav.pricing}, {key:'about' as RouteKey,label:t.nav.about}, { key: 'quote' as RouteKey, label: t.nav.quote }].map((n, i) => (
          <li style={`--i:${i}`}>
            <a href={href(locale, n.key)}>
              {n.label}
              <small>0{i + 1}</small>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mm-foot">
    <a class="btn btn--wa btn--lg" href={wa} target="_blank" rel="noopener" data-track="whatsapp" data-placement="mobile-menu"><Icon name="whatsapp" />{t.wa.ctaLong}</a>
    <div class="cluster">
      <a class="btn btn--ghost btn--sm" href={`tel:${site.phone.e164}`}><Icon name="phone" />{site.phone.display}</a>
      <nav class="lang-toggle lang-toggle--lg" aria-label={t.nav.language}>
        <Icon name="globe" />
        {LOCALES.map((l) => (
          <a href={langHref(l)} hreflang={ui[l].meta.htmlLang} lang={ui[l].meta.htmlLang} aria-current={l === locale ? 'true' : undefined}>{ui[l].meta.name}</a>
        ))}
      </nav>
    </div>
  </div>
</div>

<script>
  import '../scripts/header.ts';
</script>
