/**
 * Brand line-art: technical-drawing style illustrations that "draw" themselves
 * when scrolled into view. All original artwork — no stock photography.
 */
interface Props {
  name: string;
  class?: string;
  draw?: boolean;
  label?: string;
}
const { name, class: cls = '', draw = true, label } = Astro.props;

const pl = ' pathLength="1"';
const f = (n: number) => (Math.round(n * 10) / 10).toString();
const line = (x1: number, y1: number, x2: number, y2: number, c = 's') => `<line class="${c}" x1="${f(x1)}" y1="${f(y1)}" x2="${f(x2)}" y2="${f(y2)}"${pl}/>`;
const rect = (x: number, y: number, w: number, h: number, c = 's', rx = 0) => `<rect class="${c}" x="${f(x)}" y="${f(y)}" width="${f(w)}" height="${f(h)}"${rx ? ` rx="${rx}"` : ''}${pl}/>`;
const fill = (x: number, y: number, w: number, h: number, c = 'w', rx = 0) => `<rect class="${c}" x="${f(x)}" y="${f(y)}" width="${f(w)}" height="${f(h)}"${rx ? ` rx="${rx}"` : ''}/>`;
const slab = (x: number, y: number, w: number, h: number) => fill(x, y, w, h) + rect(x, y, w, h);
const path = (d: string, c = 's') => `<path class="${c}" d="${d}"${pl}/>`;
const circle = (cx: number, cy: number, r: number, c = 's') => `<circle class="${c}" cx="${f(cx)}" cy="${f(cy)}" r="${r}"${pl}/>`;
const text = (x: number, y: number, s: string, c = 'dimt', anchor = 'middle') => `<text class="${c}" x="${f(x)}" y="${f(y)}" text-anchor="${anchor}">${s}</text>`;

function grain(x: number, y: number, w: number, h: number, n = 3, seed = 0) {
  let s = '';
  for (let i = 1; i <= n; i++) {
    const yy = y + (h * i) / (n + 1);
    const amp = Math.min(3.2, h / (n + 1) / 3);
    let d = `M${f(x + 3)} ${f(yy)}`;
    const steps = Math.max(3, Math.round(w / 18));
    for (let k = 1; k <= steps; k++) {
      const xx = x + 3 + ((w - 6) * k) / steps;
      const cx = x + 3 + ((w - 6) * (k - 0.5)) / steps;
      const cy = yy + (k % 2 ? amp : -amp) * (0.6 + 0.4 * Math.sin(seed + i * 1.7 + k));
      d += `Q${f(cx)} ${f(cy)} ${f(xx)} ${f(yy)}`;
    }
    s += path(d, 's2');
  }
  return s;
}
function vgrain(x: number, y: number, w: number, h: number, n = 3, seed = 0) {
  let s = '';
  for (let i = 1; i <= n; i++) {
    const xx = x + (w * i) / (n + 1);
    const amp = Math.min(2.6, w / (n + 1) / 3);
    let d = `M${f(xx)} ${f(y + 3)}`;
    const steps = Math.max(3, Math.round(h / 22));
    for (let k = 1; k <= steps; k++) {
      const yy = y + 3 + ((h - 6) * k) / steps;
      const cy = y + 3 + ((h - 6) * (k - 0.5)) / steps;
      d += `Q${f(xx + (k % 2 ? amp : -amp) * (0.6 + 0.4 * Math.sin(seed + i + k)))} ${f(cy)} ${f(xx)} ${f(yy)}`;
    }
    s += path(d, 's2');
  }
  return s;
}
const dimH = (x1: number, x2: number, y: number, label: string) =>
  line(x1, y, x2, y, 'dim') + line(x1, y - 4, x1, y + 4, 'dim') + line(x2, y - 4, x2, y + 4, 'dim') + text((x1 + x2) / 2, y - 5, label);
const dimV = (x: number, y1: number, y2: number, label: string) =>
  line(x, y1, x, y2, 'dim') + line(x - 4, y1, x + 4, y1, 'dim') + line(x - 4, y2, x + 4, y2, 'dim') +
  `<text class="dimt" x="${f(x - 6)}" y="${f((y1 + y2) / 2)}" text-anchor="middle" transform="rotate(-90 ${f(x - 6)} ${f((y1 + y2) / 2)})">${label}</text>`;
const floor = (y = 268) => line(16, y, 384, y);
function books(x0: number, x1: number, base: number, seed = 1) {
  let s = '';
  let x = x0;
  let i = 0;
  while (x < x1 - 8) {
    const w = 5 + ((i * 7 + seed * 3) % 5);
    const h = 18 + ((i * 11 + seed * 5) % 13);
    if ((i + seed) % 6 === 4) {
      s += path(`M${f(x)} ${f(base)} L${f(x + 14)} ${f(base - h + 2)} L${f(x + 18)} ${f(base - h + 4)} L${f(x + 5)} ${f(base)}`, 's2');
      x += 20;
    } else {
      s += rect(x, base - h, w, h, 's2');
      x += w + 1.5;
    }
    i++;
  }
  return s;
}

