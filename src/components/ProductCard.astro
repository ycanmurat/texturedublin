---
import type { Product } from '../data/products.ts';
import type { Locale } from '../data/types.ts';
import { productHref, productText, productPrice } from '../lib/shop.ts';
import { withBase } from '../lib/paths.ts';
interface Props { product:Product; locale:Locale; }
const {product:p,locale}=Astro.props; const en=locale==='en';
---
<article class="product-card">
 <a class="product-picture" href={productHref(locale,p.slug)} tabindex="-1" aria-hidden="true">{p.poster?<img src={withBase(p.poster)} alt="" width="850" height="950" loading="lazy" />:<span>{en?'Made to order':'Déanta ar ordú'}</span>}<span class="product-label">{p.example?(en?'Example design':'Dearadh samplach'):(en?'Made to order':'Déanta ar ordú')}</span></a>
 <div class="product-card-copy"><p class="eyebrow">{en?'Texture collection':'Bailiúchán Texture'}</p><h2 class="h-m"><a href={productHref(locale,p.slug)}>{productText(p,locale,'name')}</a></h2><p>{productText(p,locale,'summary')}</p><p class="product-card-price">{p.example&&p.priceCents!==null&&<small>{en?'Illustrative price':'Praghas samplach'} · </small>}<strong>{productPrice(p,locale)}</strong></p><a class="arrow-link" href={productHref(locale,p.slug)}>{p.model?(en?'Explore design & 3D':'Féach ar an dearadh agus 3T'):(en?'View & enquire':'Féach agus fiosraigh')} →</a></div>
</article>
