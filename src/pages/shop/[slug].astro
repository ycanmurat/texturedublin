---
import Product from '../../views/Product.astro';
import { productBySlug } from '../../lib/server/store.ts';
import NotFound from '../404.astro';
import { withBase } from '../../lib/paths.ts';
export const prerender=false;
const product=productBySlug(Astro.params.slug||'');
if(!product) Astro.response.status=404;
---
{product?<Product locale="en" {product} />:<NotFound />}
