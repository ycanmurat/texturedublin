---
import type { Locale } from '../data/types.ts';
import type { RouteEntry } from '../lib/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AreaFinder from '../components/AreaFinder.astro';
import DublinMap from '../components/DublinMap.astro';
import ZoneCards from '../components/ZoneCards.astro';
import { areas } from '../data/areas.ts';
import { serviceById } from '../data/services.ts';
import { zones } from '../data/zones.ts';
import { ui } from '../i18n/ui.ts';
import { alternates, href } from '../lib/routes.ts';
import { leadLabel } from '../lib/pricing.ts';
import { abs, breadcrumbs, business, graph, webPage, website } from '../lib/schema.ts';
import { words } from '../lib/text.ts';

interface Props {
  locale: Locale;
  route: RouteEntry;
}
const { locale, route } = Astro.props;
const t = ui[locale];
const path = href(locale, 'areas');
const title = locale === 'en' ? 'Areas We Cover — Dublin, Meath & Nearby | Texture Dublin' : 'Ceantair a Chlúdaímid — Seirbhísí Áitiúla | Texture Dublin';
const description =
  locale === 'en'
    ? `Local furniture and carpentry services, fitted wardrobes, kitchens and shop signs in ${areas.length} areas across Dublin City, County Dublin, Wicklow, Kildare and Meath.`
    : `Seirbhísí áitiúla do shiúinéireacht, vardrúis, cistineacha agus comharthaí siopa i ${areas.length} ceantar ar fud Bhaile Átha Cliath agus an chriosa comaitéireachta.`;
const crumbs = [{ name: t.nav.home, href: href(locale, 'home') }, { name: t.nav.areas, href: path }];
const schema = graph([
  business(locale, true),
  website(),
  webPage({ path, title, description, locale, breadcrumb: true, type: 'CollectionPage' }),
  breadcrumbs(path, crumbs),
  {
    '@type': 'ItemList',
    '@id': `${abs(path)}#areas`,
    itemListElement: areas.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.name[locale], url: abs(href(locale, 'area', { area: a.id })) })),
  },
]);
const W = serviceById['fitted-wardrobes'];
const sorted = [...areas].sort((a, b) => a.name[locale].localeCompare(b.name[locale], locale));
---

<BaseLayout {locale} {title} {description} {path} alternates={alternates(route)} {schema} page="areas">
  <PageHero {locale} eyebrow={`${areas.length} ${t.nav.areas.toLowerCase()}`} title={t.areas.title} lede={t.areas.lede} {crumbs}>
    <div style="margin-top:28px" data-reveal><AreaFinder {locale} /></div>
  </PageHero>

  <section class="section section--paper2" aria-labelledby="zones-title">
    <div class="container split" style="align-items:start">
      <div class="stack" style="--stack:20px">
        <h2 id="zones-title" class="h-l words" data-words set:html={words(t.areas.zonesTitle)} />
        <p class="lede" data-reveal>{t.areas.zonesLede}</p>
        <ZoneCards {locale} />
      </div>
      <div data-reveal="fade"><DublinMap {locale} /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="list-title">
    <div class="container">
      <h2 id="list-title" class="h-l words" data-words set:html={words(t.areas.listTitle)} style="margin-bottom:36px" />
      {([1, 2, 3, 4] as const).map((z) => (
        <div style="margin-bottom:44px">
          <h3 class="eyebrow" style="margin-bottom:16px">{t.common.zone} {z} · {zones[z].name[locale]}</h3>
          <div class="grid grid--4" style="--gap:12px">
            {sorted.filter((a) => a.zone === z).map((a, i) => (
              <a class="card" href={href(locale, 'area', { area: a.id })} data-reveal style={`--d:${i % 4};padding:20px;gap:6px`}>
                <h3 style="font-size:1.2rem">{a.name[locale]}</h3>
                <p class="small">{a.postal}{a.eircode ? ` · ${a.eircode}` : ''}</p>
                <p class="small" style="color:var(--accent)">{W.name[locale]} {leadLabel(locale, W, a.zone)}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
