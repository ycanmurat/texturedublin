---
import { getCollection } from 'astro:content';
import type { Locale } from '../data/types.ts';
import type { RouteEntry } from '../lib/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import { ui } from '../i18n/ui.ts';
import { alternates, href } from '../lib/routes.ts';
import { abs, breadcrumbs, business, graph, webPage, website } from '../lib/schema.ts';
import { metaDesc } from '../lib/seo.ts';

interface Props {
  locale: Locale;
  route: RouteEntry;
}
const { locale, route } = Astro.props;
const t = ui[locale];
const path = href(locale, 'guides');
const title = locale === 'en' ? 'Blog: Furniture, Carpentry & Signage Advice | Texture Dublin' : 'Blag: Troscán agus Comharthaíocht | Texture Dublin';
const description = metaDesc(t.guides.lede);
const crumbs = [{ name: t.nav.home, href: href(locale, 'home') }, { name: t.guides.title, href: path }];
const posts = (await getCollection('guides')).filter((g) => g.data.locale === locale).sort((a, b) => +b.data.published - +a.data.published || +b.data.updated - +a.data.updated);
const link = (slug: string) => href(locale, 'guide', { guide: { en: slug, ga: slug } });
const schema = graph([
  business(locale),
  website(),
  webPage({ path, title, description, locale, breadcrumb: true, type: 'CollectionPage' }),
  breadcrumbs(path, crumbs),
  {
    '@type': 'Blog',
    '@id': `${abs(path)}#blog`,
    name: t.guides.title,
    url: abs(path),
    inLanguage: t.meta.htmlLang,
    publisher: { '@id': `${abs('/')}#business` },
    blogPost: posts.map((g) => ({ '@type': 'BlogPosting', headline: g.data.title, url: abs(link(g.data.slug)), datePublished: g.data.published.toISOString().slice(0, 10) })),
  },
]);
---

<BaseLayout {locale} {title} {description} {path} alternates={alternates(route)} {schema} page="guides">
  <PageHero {locale} eyebrow={t.guides.title} title={t.guides.h1} lede={t.guides.lede} {crumbs} size="l" />
  <section class="section section--tight" style="padding-top:0">
    <div class="container post-grid">
      {posts.map((g, i) => <PostCard {locale} post={g.data} href={link(g.data.slug)} index={i} featured={i === 0} eager={i < 3} />)}
    </div>
  </section>
</BaseLayout>
