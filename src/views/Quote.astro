---
import type { Locale } from '../data/types.ts';
import type { RouteEntry } from '../lib/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../config/site.ts';
import { ui } from '../i18n/ui.ts';
import { alternates, href } from '../lib/routes.ts';
import { breadcrumbs, business, graph, webPage, website } from '../lib/schema.ts';

interface Props {
  locale: Locale;
  route: RouteEntry;
}
const { locale, route } = Astro.props;
const t = ui[locale];
const path = href(locale, 'quote');
const title = locale === 'en' ? 'Get a Free Quote on WhatsApp | Texture Dublin' : 'Faigh Luachan Saor in Aisce ar WhatsApp | Texture Dublin';
const description = locale === 'en'
  ? 'Tell us about your wardrobe, kitchen, built-in, assembly or signage project and get a free quote from Texture Dublin on WhatsApp. Free survey across Dublin.'
  : 'Inis dúinn faoi do thionscadal agus faigh luachan saor in aisce ó Texture Dublin ar WhatsApp. Suirbhé saor in aisce ar fud Bhaile Átha Cliath.';
const crumbs = [{ name: t.nav.home, href: href(locale, 'home') }, { name: t.quote.title, href: path }];
const schema = graph([business(locale), website(), webPage({ path, title, description, locale, breadcrumb: true, type: 'ContactPage' }), breadcrumbs(path, crumbs)]);
---

<BaseLayout {locale} {title} {description} {path} alternates={alternates(route)} {schema} page="quote" cta={false}>
  <PageHero {locale} eyebrow="WhatsApp" title={t.quote.h1} lede={t.quote.lede} {crumbs} size="l" />
  <section class="section section--tight" style="padding-top:0">
    <div class="container split" style="align-items:start">
      <div class="card" style="padding:clamp(24px,3vw,40px)" data-reveal>
        <QuoteForm {locale} />
      </div>
      <div class="stack" style="--stack:28px">
        <ol class="steps">
          {t.process.map((s, i) => (
            <li class="step is-active" data-reveal style={`--d:${i}`}>
              <span class="n">0{i + 1}</span>
              <div><h3>{s.t}</h3><p>{s.d}</p></div>
            </li>
          ))}
        </ol>
        <p class="muted small" data-reveal>{t.contact.phone}: <a class="link" href={`tel:${site.phone.e164}`}>{site.phone.display}</a> · {t.contact.email}: <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
