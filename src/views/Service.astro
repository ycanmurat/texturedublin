---
import { ogPath } from '../lib/paths.ts';
import type { Locale } from '../data/types.ts';
import type { RouteEntry } from '../lib/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PriceTable from '../components/PriceTable.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import Estimator from '../components/Estimator.astro';
import Icon from '../components/Icon.astro';
import { serviceById } from '../data/services.ts';
import { areas } from '../data/areas.ts';
import { zones } from '../data/zones.ts';
import { standards } from '../data/standards.ts';
import { ui, fmt } from '../i18n/ui.ts';
import { alternates, href } from '../lib/routes.ts';
import { euro, fromLabel, leadItem, priceFrom, renderTokens, vatText } from '../lib/pricing.ts';
import { breadcrumbs, business, faqPage, graph, serviceNode, webPage, website } from '../lib/schema.ts';
import { waLink, waData } from '../lib/wa.ts';
import { metaDesc, shortPrice, withBrand } from '../lib/seo.ts';
import { words } from '../lib/text.ts';

interface Props {
  locale: Locale;
  route: RouteEntry;
}
const { locale, route } = Astro.props;
const t = ui[locale];
const s = serviceById[route.service!];
const path = href(locale, 'service', { service: s.id });
const lead = leadItem(s);
const wa = waLink(locale, { service: s });

const title = withBrand(locale === 'en' ? `${s.name.en} Dublin | From ${shortPrice('en', lead)}` : `${s.name.ga} | Ó ${shortPrice('ga', lead)}`);
const description = metaDesc(
  locale === 'en'
    ? `${s.short.en} From ${fromLabel('en', lead, undefined, false)} ${vatText('en', s)}. Free survey & fixed written quote — WhatsApp Texture Dublin.`
    : `${s.short.ga} Ó ${fromLabel('ga', lead, undefined, false)}. Suirbhé saor in aisce agus luachan scríofa seasta.`,
);
const crumbs = [
  { name: t.nav.home, href: href(locale, 'home') },
  { name: t.nav.services, href: href(locale, 'services') },
  { name: s.name[locale], href: path },
];
const faqs = s.faqs.map((f) => ({ q: f.q[locale], a: renderTokens(f.a[locale], s, locale) }));
const schema = graph([
  business(locale),
  website(),
  webPage({ path, title, description, locale, breadcrumb: true, image: ogPath(path) }),
  breadcrumbs(path, crumbs),
  serviceNode(s, locale, { path }),
  faqPage(path, s.faqs, locale, { service: s }),
]);

const related = s.related.map((id) => serviceById[id]).filter(Boolean);
const relatedStandards = standards.filter((x) => x.services.includes(s.id));
const estimatorFor: Record<string, 'wardrobes' | 'kitchens' | 'builtins' | 'assembly' | 'signs'> = {
  'fitted-wardrobes': 'wardrobes', 'bespoke-kitchens': 'kitchens', 'built-in-units': 'builtins', 'furniture-assembly': 'assembly', 'shop-signs': 'signs', 'illuminated-led-signs': 'signs',
};
const est = estimatorFor[s.id];
const byZone = ([1, 2, 3, 4] as const).map((z) => ({
  z,
  name: zones[z].name[locale],
  price: euro(priceFrom(lead, z)),
  list: areas.filter((a) => a.zone === z).sort((a, b) => a.name[locale].localeCompare(b.name[locale], locale)),
}));
const areaLink = (id: string) => (s.areaPages ? href(locale, 'areaService', { area: id, service: s.id }) : href(locale, 'area', { area: id }));
---

<BaseLayout {locale} {title} {description} {path} alternates={alternates(route)} {schema} service={s} page="service" ogImage={ogPath(path)}>
  <PageHero {locale} eyebrow={`${s.category === 'woodworks' ? t.nav.woodworks : t.nav.signage} · ${t.service.inDublin}`} title={s.headline[locale]} lede={s.short[locale]} {crumbs} illustration={s.illustration}>
    <div class="meta-row" data-reveal style="--d:3">
      <span class="price-badge"><small>{t.common.from}</small><strong class="num">{euro(lead.from)}</strong><small>{t.units[lead.unit]} · {vatText(locale, s)}</small></span>
    </div>
    <div class="btn-row" data-reveal style="--d:4;margin-top:22px">
      <a class="btn btn--wa btn--lg" href={wa} target="_blank" rel="noopener" {...waData('service-hero', { service: s })} data-magnetic><Icon name="whatsapp" />{t.wa.ctaLong}</a>
      <a class="btn btn--ghost btn--lg" href="#prices">{t.cta.prices}</a>
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="container split" style="align-items:start">
      <div class="stack prose" style="--stack:1.1em">
        {s.intro[locale].map((p, i) => <p data-reveal style={`--d:${i}`} class={i === 0 ? 'lede' : ''}>{p}</p>)}
      </div>
      <div class="card" data-reveal style="--d:1">
        <h2 class="h-s">{t.common.included}</h2>
        <ul class="ticks">{s.includes[locale].map((x) => <li>{x}</li>)}</ul>
        <p class="small muted"><Icon name="clock" class="inline-icon" /> {t.common.timescale}: {s.leadTime[locale]}</p>
      </div>
    </div>
  </section>

  <section class="section section--cream" id="prices" aria-labelledby="prices-title">
    <div class="container split" style="align-items:start">
      <div class="stack" style="--stack:20px">
        <span class="eyebrow" data-reveal>{t.nav.pricing}</span>
        <h2 id="prices-title" class="h-l words" data-words set:html={words(fmt(t.service.pricesTitle, { service: s.name[locale] }))} />
        <h3 class="h-s" data-reveal style="margin-top:28px">{t.common.factors}</h3>
        <ul class="dots" data-reveal>{s.factors[locale].map((x) => <li>{x}</li>)}</ul>
      </div>
      <div data-reveal style="--d:1"><PriceTable {locale} services={[s]} /></div>
    </div>
  </section>

  {
    est && (
      <section class="section section--tight">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow" data-reveal>{t.pricing.estimatorTitle}</span>
            <h2 class="h-l words" data-words set:html={words(t.home.estimateTitle)} />
          </div>
          <div data-reveal><Estimator {locale} start={est} /></div>
        </div>
      </section>
    )
  }

  <section class="section section--paper2" aria-labelledby="areas-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-reveal>{t.common.pricesByArea}</span>
        <h2 id="areas-title" class="h-l words" data-words set:html={words(fmt(t.service.areasTitle, { service: s.name[locale] }))} />
        <p class="lede" data-reveal>{t.service.areasLede}</p>
      </div>
      <div class="grid grid--2">
        {byZone.map((z, i) => (
          <div class="card" data-reveal style={`--d:${i}`}>
            <div class="card-top">
              <h3>{t.common.zone} {z.z} · {z.name}</h3>
              <strong class="num" style="font-family:var(--f-serif);font-weight:400;color:var(--accent)">{t.price.from} {z.price}</strong>
            </div>
            <div class="cluster" style="--gap:8px">
              {z.list.map((a) => <a class="chip" href={areaLink(a.id)}>{a.name[locale]}</a>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {
    relatedStandards.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <div class="section-head section-head--row">
            <h2 class="h-l words" data-words set:html={words(t.common.standards)} />
            <a class="arrow-link" href={href(locale, 'standards')} style="justify-self:end">{t.nav.standards} <Icon name="arrow" /></a>
          </div>
          <div class="grid grid--3">
            {relatedStandards.map((x, i) => (
              <div class="card" data-reveal style={`--d:${i}`}>
                <h3 class="h-s">{x.title[locale]}</h3>
                <p class="small">{x.body[locale]}</p>
                <p class="small" style="color:var(--accent)">{x.ref}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="faq-title">
    <div class="container split" style="align-items:start">
      <div class="stack" style="--stack:20px">
        <span class="eyebrow" data-reveal>FAQ</span>
        <h2 id="faq-title" class="h-l words" data-words set:html={words(t.common.faq)} />
      </div>
      <FAQ {locale} items={faqs} openFirst />
    </div>
  </section>

  <section class="section section--paper2 section--tight" aria-labelledby="related-title">
    <div class="container">
      <h2 id="related-title" class="h-l words" data-words set:html={words(t.common.related)} style="margin-bottom:36px" />
      <div class="grid grid--3">
        {related.map((r, i) => <ServiceCard {locale} service={r} index={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>
