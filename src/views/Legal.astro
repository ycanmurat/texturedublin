---
import { getCollection, render } from 'astro:content';
import type { Locale } from '../data/types.ts';
import type { RouteEntry } from '../lib/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../config/site.ts';
import { ui } from '../i18n/ui.ts';
import { alternates, href } from '../lib/routes.ts';
import { breadcrumbs, business, graph, webPage, website } from '../lib/schema.ts';

interface Props {
  locale: Locale;
  route: RouteEntry;
}
const { locale, route } = Astro.props;
const t = ui[locale];
const entry = (await getCollection('legal')).find((e) => e.data.locale === locale && e.data.key === route.key)!;
const { Content } = await render(entry);
const path = href(locale, route.key);
const crumbs = [{ name: t.nav.home, href: href(locale, 'home') }, { name: entry.data.title, href: path }];
const title = `${entry.data.title} | Texture Dublin`;
const schema = graph([business(locale), website(), webPage({ path, title, description: entry.data.description, locale, breadcrumb: true }), breadcrumbs(path, crumbs)]);
const fmtDate = (d: Date) => d.toLocaleDateString(locale === 'ga' ? 'ga-IE' : 'en-IE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout {locale} {title} description={entry.data.description} {path} alternates={alternates(route)} {schema} page="legal" cta={false}>
  <section class="page-hero">
    <div class="container--narrow">
      <Breadcrumbs {locale} items={crumbs} />
      <h1 class="h-xl" style="margin-top:28px">{entry.data.title}</h1>
      <p class="small muted">{t.legal.lastUpdated}: {fmtDate(entry.data.updated)} · {site.legalName}</p>
    </div>
  </section>
  <section class="section section--tight" style="padding-top:0">
    <div class="container--narrow prose">
      <Content />
      {route.key === 'cookies' && <p><button type="button" class="btn btn--ink" data-consent-open>{t.footer.cookies}</button></p>}
    </div>
  </section>
</BaseLayout>
