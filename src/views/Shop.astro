---
import type { Locale } from '../data/types.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../lib/server/store.ts';
import { href } from '../lib/routes.ts';
import { abs, breadcrumbs, business, graph, webPage, website } from '../lib/schema.ts';
import { productHref, productText } from '../lib/shop.ts';
import '../styles/shop.css';
interface Props { locale:Locale; }
const {locale}=Astro.props; const en=locale==='en'; const list=products(); const path=href(locale,'shop');
Astro.response.headers.set('Cache-Control','no-store, no-transform');
const title=en?'Made-to-Order Furniture Shop | Texture Dublin':'Siopa Troscáin ar Ordú | Texture Dublin';
const description=en?'Explore made-to-order wardrobe designs from Texture Dublin in Dunboyne. View a design in 3D and send Ali Onder a WhatsApp enquiry for a tailored quote.':'Féach ar dhearaí vardrúis ó Texture Dublin i nDún Búinne. Amharc 3T agus fiosrúcháin WhatsApp le Ali Onder le haghaidh luachan.';
const crumbs=[{name:en?'Home':'Baile',href:href(locale,'home')},{name:en?'Shop':'Siopa',href:path}];
const schema=graph([business(locale),website(),webPage({path,title,description,locale,type:'CollectionPage',breadcrumb:true}),breadcrumbs(path,crumbs),{'@type':'ItemList',itemListElement:list.map((p,i)=>({'@type':'ListItem',position:i+1,name:productText(p,locale,'name'),url:abs(productHref(locale,p.slug))}))}]);
---
<BaseLayout {locale} {title} {description} {path} {schema} alternates={{en:href('en','shop'),ga:href('ga','shop')}} page="shop">
 <PageHero {locale} eyebrow={en?'The Texture collection':'Bailiúchán Texture'} title={en?'A starting point. Made yours.':'Túsphointe. Déanta duitse.'} lede={en?'Explore a design, look around in 3D and tell us what would make it yours. Every enquiry goes straight to Ali Onder.':'Féach ar dhearadh i 3T agus inis dúinn cad atá uait. Téann gach fiosrúchán díreach chuig Ali Onder.'} {crumbs} />
 <section class="section shop-catalogue"><div class="container"><div class="shop-note"><span class="eyebrow">{en?'How it works':'Conas a oibríonn sé'}</span><p>{en?'Choose a design → select quantity and finish → enquire on WhatsApp. Ali confirms materials, dimensions, the final price and delivery before you agree an order. Example designs and prices are clearly marked.':'Roghnaigh dearadh, cainníocht agus bailchríoch, agus fiosraigh ar WhatsApp. Deimhníonn Ali na hábhair, toisí, praghas agus seachadadh sula n-aontaítear ordú.'}</p></div>{list.length?<div class="product-grid">{list.map(p=><ProductCard product={p} {locale} />)}</div>:<div class="callout"><h2 class="h-m">{en?'New designs are on their way.':'Tá dearaí nua ag teacht.'}</h2><p>{en?'Have something in mind? Share your room and ideas with Ali Onder.':'An bhfuil smaoineamh agat? Roinn é le Ali Onder.'}</p><a href={href(locale,'contact')}>{en?'Contact Ali':'Déan teagmháil le Ali'} →</a></div>}</div></section>
</BaseLayout>
