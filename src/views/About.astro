---
import type { Locale } from '../data/types.ts';
import type { RouteEntry } from '../lib/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Logo from '../components/Logo.astro';
import DublinMap from '../components/DublinMap.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../i18n/ui.ts';
import { alternates, href } from '../lib/routes.ts';
import { breadcrumbs, business, graph, webPage, website } from '../lib/schema.ts';
import { words } from '../lib/text.ts';
import { metaDesc } from '../lib/seo.ts';

interface Props {
  locale: Locale;
  route: RouteEntry;
}
const { locale, route } = Astro.props;
const t = ui[locale];
const path = href(locale, 'about');
const title = locale === 'en' ? 'About Texture Dublin — Bespoke Wood Works & Branding' : 'Faoi Texture Dublin — Obair Adhmaid agus Brandáil';
const description = metaDesc(t.about.lede);
const crumbs = [{ name: t.nav.home, href: href(locale, 'home') }, { name: t.nav.about, href: path }];
const schema = graph([business(locale, true), website(), webPage({ path, title, description, locale, breadcrumb: true, type: 'AboutPage' }), breadcrumbs(path, crumbs)]);

const copy = {
  en: {
    crafts: 'Two specialist teams, one company',
    p1: 'Texture Dublin is a furniture and carpentry service and a specialist signage service under one company. On the woodworks side we design, build and install fitted wardrobes, kitchens, built-in units and made-to-measure cabinets — and we take on the practical jobs too: flat-pack assembly, installation and general carpentry.',
    p2: 'Our dedicated signage specialist provides sign production and installation: shop fascias, illuminated letters, timber signs, office signage and window graphics. Furniture and signage are separate specialisms within Texture Dublin; Ali Onder is your enquiry contact.',
    p3: 'Keeping both crafts together means fewer handovers and better results. A café can get its counter, menu boards and fascia through one company; a homeowner can get a kitchen, a matching utility and a carved house sign without managing three suppliers.',
    valuesTitle: 'What we care about',
    values: [
      ['Precision', 'We measure twice, scribe on site and finish every edge. Good joinery lives in the details nobody notices.'],
      ['Honest pricing', 'A quotation based on your specification, with materials, VAT, access and installation clearly set out.'],
      ['Materials that last', 'Quality boards, solid timber, proven European hardware and finishes that meet EU standards.'],
      ['Respect for your home', 'Floor protection, dust control, tidy working — and all the packaging taken away.'],
    ],
    logoTitle: 'The mark',
    logoText: 'Our logo brings the two crafts together: timber grain flowing through a frame that becomes a “D” for Dublin, with the set square and dividers every design starts with.',
  },
  ga: {
    crafts: 'Dhá sheirbhís, comhlacht amháin',
    p1: 'Is seirbhís troscáin agus seirbhís chomharthaíochta ar leith faoin gcomhlacht céanna é Texture Dublin. Ar thaobh na hoibre adhmaid dearaimid, tógaimid agus suiteálaimid vardrúis fheistithe, cistineacha, aonaid ionsuite agus caibinéid de réir tomhais — agus glacaimid leis na jabanna praiticiúla freisin: cóimeáil flat-pack, suiteáil agus siúinéireacht ghinearálta.',
    p2: 'Láimhseálann ár saineolaí comharthaíochta táirgeadh agus suiteáil comharthaí: cláir aghaidhe siopaí, litreacha soilsithe, comharthaí adhmaid snoite, comharthaíocht oifige agus grafaicí fuinneoige. Comhordaíonn Ali Onder do fhiosrúchán.',
    p3: 'Má choinnítear an dá cheird le chéile, bíonn níos lú aistrithe agus torthaí níos fearr ann. Is féidir le caifé a chuntar, a chláir bhiachláir agus a chlár aghaidhe a fháil tríd an gcomhlacht céanna; is féidir le húinéir tí cistin, seomra fóntais meaitseáilte agus comhartha tí snoite a fháil gan trí sholáthraí a bhainistiú.',
    valuesTitle: 'Cad atá tábhachtach dúinn',
    values: [
      ['Beachtas', 'Tomhaisimid faoi dhó, oiriúnaímid ar an láthair agus críochnaímid gach imeall. Bíonn siúinéireacht mhaith sna mionsonraí nach dtugann aon duine faoi deara.'],
      ['Praghsáil mhacánta', 'Luachan scríofa de réir do shonraíochta, ábhair, CBL, rochtain agus suiteáil san áireamh.'],
      ['Ábhair a mhaireann', 'Cláir ardchaighdeáin, adhmad soladach, crua-earraí Eorpacha cruthaithe agus bailchríocha a chomhlíonann caighdeáin an AE.'],
      ['Meas ar do theach', 'Cosaint urláir, rialú deannaigh, obair néata — agus an pacáistiú ar fad tógtha chun siúil.'],
    ],
    logoTitle: 'An lógó',
    logoText: 'Tugann ár lógó an dá cheird le chéile: gráin adhmaid ag sileadh trí fhráma a dhéanann “D” do Bhaile Átha Cliath, leis an gcearnóg shocraithe agus an roinnteoir a dtosaíonn gach dearadh leo.',
  },
}[locale];
---

<BaseLayout {locale} {title} {description} {path} alternates={alternates(route)} {schema} page="about">
  <PageHero {locale} eyebrow={t.about.title} title={t.about.h1} lede={t.about.lede} {crumbs} illustration="brand" />

  <section class="section section--tight" style="padding-top:0">
    <div class="container split" style="align-items:start">
      <h2 class="h-xl words" data-words set:html={words(copy.crafts)} />
      <div class="stack prose">
        <p class="lede" data-reveal>{copy.p1}</p>
        <p data-reveal style="--d:1">{copy.p2}</p>
        <p data-reveal style="--d:2">{copy.p3}</p>
        <div class="btn-row" data-reveal style="--d:3">
          <a class="btn btn--ink" href={href(locale, 'services')}>{t.nav.services} <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={href(locale, 'standards')}>{t.nav.standards}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark" aria-labelledby="values-title">
    <div class="container">
      <h2 id="values-title" class="h-xl words" data-words set:html={words(copy.valuesTitle)} style="margin-bottom:40px" />
      <div class="grid grid--4 why">
        {copy.values.map(([h, p], i) => (
          <div class="why-item" data-reveal style={`--d:${i}`}>
            <h3>{h}</h3>
            <p class="muted">{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="mark-title">
    <div class="container split">
      <div class="stack" style="--stack:20px">
        <h2 id="mark-title" class="h-l words" data-words set:html={words(copy.logoTitle)} />
        <p class="lede" data-reveal>{copy.logoText}</p>
      </div>
      <div data-reveal="fade" style="max-width:520px;--logo-grain:var(--oak-deep);--logo-accent:var(--oak-deep);--logo-sub:var(--muted)">
        <Logo variant="stacked" {locale} />
      </div>
    </div>
  </section>

  <section class="section section--paper2" aria-labelledby="where-title">
    <div class="container split">
      <div class="stack" style="--stack:20px">
        <h2 id="where-title" class="h-l words" data-words set:html={words(t.home.mapTitle)} />
        <p class="lede" data-reveal>{t.home.mapLede}</p>
        <a class="arrow-link" href={href(locale, 'areas')} data-reveal>{t.nav.allAreas} <Icon name="arrow" /></a>
      </div>
      <div data-reveal="fade"><DublinMap {locale} /></div>
    </div>
  </section>
</BaseLayout>
